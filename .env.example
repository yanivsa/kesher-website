# Google Tag Manager container ID (e.g., GTM-XXXXXXX)
# Required for analytics events to reach GTM/GA4/Google Ads
VITE_GTM_CONTAINER_ID=

# GA4 Measurement ID (e.g., G-XXXXXXXXXX) — configured inside GTM
# Not used directly in code; documented here for reference
VITE_GA4_MEASUREMENT_ID=

# Google Ads account ID (e.g., AW-XXXXXXXXXX) — configured inside GTM
# Not used directly in code; documented here for reference
VITE_GOOGLE_ADS_ID=

# Google Ads conversion label for booking (e.g., AbCdEfGhIjKlMn)
# Not used directly in code; documented here for reference
VITE_GOOGLE_ADS_BOOKING_LABEL=

# Meta Pixel ID (e.g., 123456789012345) — configured inside GTM
# Not used directly in code; documented here for reference
VITE_META_PIXEL_ID=

# Optional server-side free stock B-roll. Missing keys are a clean no-op.
# These are NOT VITE_ variables and must never be exposed to the browser bundle.
PEXELS_API_KEY=
PIXABAY_API_KEY=
KESHER_BROLL_ENABLED=true
KESHER_BROLL_BUDGET_SECONDS=12
