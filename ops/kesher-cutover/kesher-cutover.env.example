# Copy to /etc/kesher-cutover/kesher-cutover.env with mode 0600.
# Values below are placeholders/identifiers only. Never commit live credentials.

KESHER_CUTOVER_REVIEW_FILE=/etc/kesher-cutover/review.json
KESHER_CUTOVER_MATERIAL_FILE=/etc/kesher-cutover/migration-material.json
KESHER_CUTOVER_CLOSURE_FILE=/etc/kesher-cutover/closure.json
KESHER_CUTOVER_BINDINGS_FILE=/etc/kesher-cutover/resource-bindings.json
KESHER_CUTOVER_REGISTRATIONS_FILE=/etc/kesher-cutover/registration-bindings.json
KESHER_CUTOVER_KEY_BINDING_FILE=/etc/kesher-cutover/key-binding.json
KESHER_CUTOVER_NATIVE_FACTORY=REPLACE_WITH_REVIEWED_NATIVE_MODULE:build
KESHER_CUTOVER_OIDC_AUDIENCE=https://REPLACE_WITH_EXACT_GATEWAY_ORIGIN
KESHER_CUTOVER_JOURNAL=/var/lib/kesher-cutover/invocations.sqlite
KESHER_CUTOVER_EPOCH=REPLACE_WITH_ADMIN_APPROVED_EPOCH
KESHER_CUTOVER_OWNER=kesher-canonical-controller
KESHER_GITHUB_REPOSITORY=yanivsa/kesher-website
KESHER_GITHUB_REPOSITORY_ID=1239881973
KESHER_CUTOVER_ROOT=/opt/kesher-cutover/current
