{
  "contract_version": 3,
  "controller_state_schema_version": 3,
  "scheduler": {
    "owner": "kesher-content-controller",
    "heartbeat_minutes": 5,
    "failure_recovery": "heartbeat"
  },
  "supervisor": {
    "owner": "kesher-master-supervisor",
    "mode": "live_s1_s2_s3",
    "production_state_writer": "kesher-content-controller-v5",
    "escalation_owner": "kesher-master-supervisor",
    "state_ref": "automation-supervisor-state",
    "state_path": ".kesher-master-supervisor/state.json",
    "heartbeat_minutes": 10,
    "single_action_per_audit": true,
    "escalation": {
      "S1": "controller",
      "S2": "jules",
      "S3": "direct",
      "after_S3_same_incident": "human_blocker"
    },
    "external_running_heartbeat_exception_minutes": 90,
    "recovery_commands": {
      "idempotent": true,
      "deterministic_command_id": true,
      "persist_before_side_effect": true,
      "cas_protected_state": true,
      "uncertain_mutation_never_blind_retried": true,
      "stale_commands_noop": true,
      "exact_source_identity_required": true,
      "duplicate_active_command_noop": true,
      "duplicate_completed_command_noop": true
    },
    "jules_incident_packet": {
      "required": true,
      "reuse_existing_session_pr": true,
      "includes_definition_of_done": true,
      "includes_exact_artifact_ids": true,
      "no_duplicate_generation_upload": true
    },
    "action_lifecycle": [
      "planned",
      "issued",
      "acknowledged",
      "running",
      "verified",
      "failed",
      "timed_out"
    ],
    "human_blockers": [
      "2fa",
      "new_secret",
      "new_external_permission",
      "payment",
      "irreversible_external_action",
      "production_identity_ambiguity",
      "same_incident_after_s3",
      "no_safe_direct_adapter"
    ]
  },
  "retry": {
    "max_attempts_per_stage": 3,
    "backoff_minutes": [5, 15],
    "attempts_include_initial_run": true
  },
  "article": {
    "generator": "jules",
    "worker_session_attempts": 1,
    "max_attempts": 3,
    "retry_backoff_minutes": [5, 15],
    "publication_ready_requires_trusted_image": true,
    "jules_pending_image_handoff_status": "PENDING_TRUSTED_IMAGE_STAGE"
  },
  "image": {
    "required_for_article": true,
    "publication_blocking": true,
    "worker_owner": "github-actions",
    "worker_attempts_per_dispatch": 1,
    "max_attempts": 3,
    "provider_order": ["gemini", "unsplash", "pexels", "local-curated", "local-editorial"],
    "gemini_model": "gemini-3.1-flash-image",
    "visual_verifier_model": "gemini-3.5-flash",
    "external_stock_requires_pixel_verification": true,
    "fallback_must_be_local": true,
    "no_image_publication_allowed": false,
    "failure_mode": "blocking-retry",
    "pending_handoff_marker": "Hero Image Status: PENDING_TRUSTED_IMAGE_STAGE",
    "attached_handoff_marker": "Hero Image Status: ATTACHED_TRUSTED_IMAGE_STAGE",
    "controller_action_on_pending_handoff": "dispatch_trusted_image_same_pr",
    "controller_action_on_image_guard_failure": "recover_trusted_image_same_pr"
  },
  "video": {
    "publication_gate": "technical",
    "jules_review": "advisory",
    "queue_order": "fifo",
    "max_attempts_per_stage": 3,
    "durable_state_artifacts_to_keep": 3,
    "durable_state_retention_days": 14,
    "voice_policy": {
      "preferred_voice": "female",
      "female_attempts_before_fallback": 3,
      "fallback_voice_after_failed_female_attempts": "male",
      "applies_to": ["video_overview", "short"],
      "retry_on_detected_male_before_fallback": true,
      "accept_male_on_final_female_attempt": true,
      "stop_voice_retries_after_fallback": true,
      "final_attempt_failure_action": "upload_last_usable_same_source_artifact",
      "final_attempt_number": 3,
      "last_usable_must_match_slug_and_content_sha256": true,
      "never_generate_after_final_attempt_fallback": true,
      "public_verify_after_fallback_upload": true
    },
    "enhancement": {
      "required_for_publication": false,
      "shared_engine": "remotion",
      "profiles": ["overview_16_9", "short_9_16"],
      "missing_assets": "source-only-fallback",
      "asset_failure": "drop-and-continue",
      "jules_review": "advisory",
      "duplicate_generation_for_enrichment": false,
      "signature_timing": "overlay_final_2_3_seconds_inside_source_timeline",
      "signature_may_extend_final_duration": false
    }
  },
  "invariants": {
    "one_article_per_slot": true,
    "one_video_per_article": true,
    "workers_are_single_attempt": true,
    "controller_owns_retries": true,
    "heartbeat_is_recovery_only": true,
    "provider_ids_are_persisted_before_followup": true,
    "youtube_insert_is_idempotent": true,
    "article_image_handoff_is_machine_readable": true,
    "image_guard_failure_repairs_same_pr": true,
    "master_is_only_escalation_owner_when_live": true,
    "supervisor_never_writes_production_state": true,
    "recovery_commands_are_idempotent": true,
    "legacy_task_supervisor_live_mutations_disabled": true,
    "supervisor_state_is_cas_protected": true,
    "same_incident_escalation_is_bounded": true,
    "signature_overlay_stays_inside_source_timeline": true,
    "signature_never_extends_media_duration": true
  }
}
