{
  "name": "kesher",
  "version": "1.0.0",
  "type": "module",
  "description": "Production website for Shira Saharoni, deployed on Cloudflare Pages.",
  "scripts": {
    "dev": "vite",
    "generate": "node scripts/generate-post-summaries.cjs && node scripts/generate-sitemap.cjs && node scripts/generate-llms-full.cjs",
    "prebuild": "npm run generate",
    "typecheck": "tsc && tsc -p tsconfig.functions.json",
    "build": "npm run typecheck && vite build && node scripts/prerender.cjs",
    "preview": "vite preview",
    "lint": "eslint src functions tests scripts/*.cjs scripts/generate-article-image.js vite.config.js",
    "test": "vitest run",
    "test:content": "node scripts/validate-content.cjs && node tests/automation-gates.test.cjs",
    "test:e2e": "playwright test",
    "verify:dist": "node scripts/verify-dist.cjs",
    "check": "npm run generate && npm run lint && npm run test:content && npm run test && npm run build && npm run verify:dist && npm run test:e2e"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yanivsa/kesher-website.git"
  },
  "keywords": [
    "couples counseling",
    "parenting guidance",
    "ashdod"
  ],
  "author": "Shira Saharoni",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/yanivsa/kesher-website/issues"
  },
  "homepage": "https://kesher.saharoni.com",
  "dependencies": {
    "@vitejs/plugin-react-swc": "^4.3.1",
    "dompurify": "^3.4.12",
    "framer-motion": "^12.40.0",
    "fuse.js": "^7.5.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-icons": "^5.6.0",
    "react-router-dom": "^7.18.0",
    "vite": "^8.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@cloudflare/workers-types": "^4.20260617.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.0",
    "@remotion/cli": "^4.0.506",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.6.0",
    "playwright": "^1.60.0",
    "remotion": "^4.0.506",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vitest": "^4.1.9"
  }
}
