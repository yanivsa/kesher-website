{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kesher-mcp-staging",
  "main": "src/index.mjs",
  "compatibility_date": "2026-10-02",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true
    }
  }
}
