{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kesher-mcp-v2-staging",
  "main": "src/index.mjs",
  "compatibility_date": "2026-10-02",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "ratelimits": [
    {
      "name": "MCP_RATE_LIMITER",
      "namespace_id": "20261003",
      "simple": {
        "limit": 300,
        "period": 60
      }
    }
  ]
}
