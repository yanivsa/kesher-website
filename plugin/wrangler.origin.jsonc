{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kesher-mcp-origin",
  "main": "src/index.mjs",
  "compatibility_date": "2026-10-02",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "observability": {
    "enabled": false
  },
  "ratelimits": [
    {
      "name": "MCP_RATE_LIMITER",
      "namespace_id": "20261003",
      "simple": {
        "limit": 300,
        "period": 60
      }
    }
  ]
}
